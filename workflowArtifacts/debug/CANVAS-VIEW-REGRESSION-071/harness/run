#!/usr/bin/env python3
"""Run the evidence probes for CANVAS-VIEW-REGRESSION-071."""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


N = 3
HERE = Path(__file__).resolve().parent
REPO = HERE.parents[3]
PLUGIN = REPO / "plugin"
VITEST_CONFIG = HERE / "vitest.config.ts"


@dataclass(frozen=True)
class Probe:
    probe_id: str
    kind: str
    path: Path
    assertion: str


PROBES = (
    Probe(
        "P1",
        "code-level",
        HERE / "probes" / "p1_owned_sweep_heals_lock_revert.test.ts",
        f"an owned periodic sweep repairs a lock/revert paint-model split within N={N} ticks",
    ),
    Probe(
        "P2",
        "code-level",
        HERE / "probes" / "p2_remount_orphans_sweep.test.ts",
        f"a replacement adapter still repairs the visible card within N={N} ticks",
    ),
    Probe(
        "P3",
        "code-level",
        HERE / "probes" / "p3_connected_setdata_order.test.ts",
        "applyNodeGeometry -> repaintNode -> setData preserves visible/model agreement",
    ),
    Probe(
        "P4",
        "integration",
        HERE / "probes" / "p4_live_paint_census.py",
        "the current mounted authorized Canvas has a readable paint plane with no divergence",
    ),
    Probe(
        "P5",
        "integration",
        HERE / "probes" / "p5_live_leaf_paint_census.py",
        "every mounted authorized same-path Canvas leaf has readable model/paint with no attached divergence",
    ),
)


def select(args: argparse.Namespace) -> list[Probe]:
    if args.all:
        return list(PROBES)
    if args.probes:
        wanted = {item.strip().upper() for raw in args.probes for item in raw.split(",") if item.strip()}
        unknown = wanted - {probe.probe_id for probe in PROBES}
        if unknown:
            raise SystemExit(f"unknown probe id(s): {', '.join(sorted(unknown))}")
        return [probe for probe in PROBES if probe.probe_id in wanted]
    if args.kind:
        wanted_kinds = {item.strip().lower() for raw in args.kind for item in raw.split(",") if item.strip()}
        unknown = wanted_kinds - {probe.kind for probe in PROBES}
        if unknown:
            raise SystemExit(f"unknown kind(s): {', '.join(sorted(unknown))}")
        return [probe for probe in PROBES if probe.kind in wanted_kinds]
    raise SystemExit("choose exactly one of --all, --probes, or --kind")


def command_for(probe: Probe) -> list[str]:
    if probe.path.suffix == ".py":
        return [sys.executable, str(probe.path)]
    vitest = PLUGIN / "node_modules" / ".bin" / ("vitest.cmd" if os.name == "nt" else "vitest")
    return [str(vitest), "run", "--config", str(VITEST_CONFIG), str(probe.path)]


def useful_detail(output: str) -> str:
    ansi = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
    lines = [
        " ".join(ansi.sub("", line).split())
        for line in output.splitlines()
        if line.strip()
    ]
    detail = ""
    for token in ("AssertionError", "LIVE_", "PAINT_MODEL", "expected"):
        detail = next((line for line in lines if token.lower() in line.lower()), "")
        if detail:
            break
    if not detail:
        detail = (lines or ["no diagnostic output"])[-1]
    return detail[:360]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--all", action="store_true")
    group.add_argument("--probes", nargs="+", metavar="ID")
    group.add_argument("--kind", nargs="+", metavar="KIND")
    args = parser.parse_args()

    fired = False
    for probe in select(args):
        completed = subprocess.run(
            command_for(probe),
            cwd=PLUGIN,
            text=True,
            encoding="utf-8",
            errors="replace",
            capture_output=True,
            env={**os.environ, "CANVAS_HUNT_N": str(N)},
            check=False,
        )
        combined = f"{completed.stdout}\n{completed.stderr}"
        if completed.returncode == 0:
            print(f"{probe.probe_id} {probe.kind} CLEAR - {probe.assertion}")
        elif completed.returncode == 2 and "HARNESS_SKIP" in combined:
            print(f"{probe.probe_id} {probe.kind} SKIP - {useful_detail(combined)}")
        else:
            fired = True
            print(f"{probe.probe_id} {probe.kind} FIRED - {useful_detail(combined)}")
    return 1 if fired else 0


if __name__ == "__main__":
    raise SystemExit(main())
